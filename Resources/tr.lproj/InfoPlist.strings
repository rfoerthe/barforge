/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Barforge; dosyaları taşımak, öğeleri Çöp Sepeti’ne göndermek, istenen komutları açmak ve medya uygulamalarınızda oynatmayı denetlemek için Otomasyon kullanır.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Barforge, mikserde ses düzeyini ayarlamak ve başlattığın ekran kayıtlarına Mac'in sesini eklemek için her uygulamanın sesini kullanır. Hiçbir şey Mac'inden çıkmaz.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Barforge, Bluetooth'u yalnızca bağlı çevre birimlerinin pil düzeyini okumak için kullanır. Hiçbir veri Mac'inden çıkmaz.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Barforge, mikrofonunuzu yalnızca ekran kaydı için açtığınızda kaydeder. Geçici bir bağlantı oluşturmadığınız sürece ses Mac'inizde kalır.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Barforge, kameranızı yalnızca açtığınız önizleme penceresinde gösterir; böylece aramadan önce nasıl göründüğünüzü kontrol edebilirsiniz. Hiçbir şey kaydedilmez veya Mac'inizden çıkmaz.";

/* macOS Downloads folder permission prompt. */
